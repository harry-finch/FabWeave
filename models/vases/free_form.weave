[params.bottom_layers]
type = "int"
label = { fr = "Fond (couches)", en = "Bottom layers" }
help = { fr = "Couches pleines (anneaux) sous la spirale ; 0 : manchon ouvert.", en = "Solid layers (rings) under the spiral; 0: open sleeve." }
advanced = true
default = 2
min = 0
max = 4

[params.speed]
type = "float"
label = { fr = "Vitesse", en = "Speed" }
unit = "mm/s"
advanced = true
default = 30
min = 5
max = 120
step = 1

[params.width_factor]
type = "float"
label = { fr = "Largeur boudin", en = "Bead width" }
unit = "×"
help = { fr = "Largeur d'extrusion, en multiple du diamètre de buse.", en = "Extrusion width, as a multiple of the nozzle diameter." }
advanced = true
default = 2
min = 1
max = 3
step = 0.1

[params.height_factor]
type = "float"
label = { fr = "Pas vertical", en = "Rise per turn" }
unit = "×"
help = { fr = "Montée par tour, en multiple du diamètre de buse.", en = "Rise per turn, as a multiple of the nozzle diameter." }
advanced = true
default = 0.5
min = 0.2
max = 0.8
step = 0.05
---
// Forme libre (FabWeave) : silhouette, section, torsion et cage calculées
// en natif par `revolve` (R-023), en une spirale continue sur un fond plein.

let ew = printer.nozzle_diameter * params.width_factor;   // largeur du boudin
let eh = printer.nozzle_diameter * params.height_factor;  // montée par tour
let fh = printer.first_layer_height;
let nb = params.bottom_layers;
let segs = max(180, params.sides * 12).to_int();

let offsets = [];
for ring in 0..3 {
    for i in 1..=6 {
        offsets.push(params[`cage_${ring}_${i}`]);
    }
}
let shape = #{
    profile: params.silhouette,
    section: section(params.section, params.sides, params.depth / 100.0),
    twist: params.twist,
    twist_kind: params.twist_kind,
    taper: params.taper / 100.0,
    cage: cage(3, 6, offsets, params.cage_softness),
    pitch: eh,
    segments: segs,
};

let path = new_path();

// Fond : contour à la section du pied, puis anneaux.
let fw = printer.nozzle_diameter * 1.125;
for j in 0..nb {
    let z = fh + j * eh;
    let h = if j == 0 { fh } else { eh };
    shape.start = z;
    let contour = revolve_ring(shape, z);
    path.travel_to(contour);
    path.print_points(contour, ew, h);
    if j == 0 {
        path.note(#{ fr: "Fond : contour, puis anneaux", en: "Bottom: outline, then rings" });
    }
    for r in contour.fill_rings(fw, ew / 2 + fw * 0.35) {
        path.travel_to(r);
        path.print_points(r, fw, h);
    }
}

// Spirale : de la dernière couche du fond (ou du plateau) au haut de la silhouette.
shape.start = if nb == 0 { 0.8 * eh } else { fh + (nb - 1) * eh };
if params.silhouette.max_z - shape.start < eh {
    fail(#{ fr: "Silhouette trop basse pour une spirale : monter le dernier point.", en: "Silhouette too low for a spiral: raise the last point." });
}
let wall = revolve(shape);
path.set_speed(params.speed / 2);
path.travel_to(wall);
path.note(#{ fr: "Départ de la spirale", en: "Spiral start" });
// Premier tour au ralenti, le reste à la vitesse demandée.
let first = wall.slice(0, segs + 1);
path.print_points(first, ew, eh);
path.set_speed(params.speed);
path.print_points(wall.slice(segs, wall.len()), ew, eh);
path
