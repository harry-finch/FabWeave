format = "fabweave.model"
version = 2

[meta]
name = { fr = "Forme libre", en = "Free form" }
category = { fr = "Vases et luminaires", en = "Vases & lamps" }
description = { fr = "Une silhouette dessinée, une section vue de dessus (pétale, étoile, cannelé…), une torsion et une cage dont chaque point pousse ou rentre la paroi : de quoi composer vases, pots et abat-jour en une spirale continue, sur un fond plein qui suit la section.", en = "A drawn silhouette, a section seen from above (petal, star, fluted…), a twist and a cage whose points push or pull the wall: compose vases, pots and shades as one continuous spiral, on a solid bottom that follows the section." }
author = "FabWeave"
tags = ["vase", "spirale", "silhouette", "section", "torsion", "cage"]
license = "GPL-3.0-or-later"
recommended_nozzle = [0.4, 0.5, 0.6]

[params.silhouette]
type = "curve"
label = { fr = "Silhouette", en = "Silhouette" }
unit = "mm"
help = { fr = "Rayon extérieur selon la hauteur ; la section creuse vers l'intérieur. Le vase est aussi haut que le dernier point.", en = "Outer radius against height; the section cuts inwards. The vase is as tall as the last point." }
default = [[32, 0], [42, 40], [34, 90], [38, 110]]
min = [10, 0]
max = [100, 250]
points = [2, 16]
presets = [
    { name = { fr = "Pot", en = "Pot" }, points = [[32, 0], [42, 40], [34, 90], [38, 110]] },
    { name = { fr = "Colonne", en = "Column" }, points = [[30, 0], [30, 160]] },
    { name = { fr = "Coupe", en = "Bowl" }, points = [[25, 0], [55, 35], [70, 60]] },
    { name = { fr = "Lanterne", en = "Lantern" }, points = [[28, 0], [45, 60], [28, 120]] },
]

[params.section]
type = "choice"
label = { fr = "Section", en = "Section" }
help = { fr = "Forme vue de dessus.", en = "Shape seen from above." }
default = "petal"
options = [
    { value = "round", label = { fr = "Ronde", en = "Round" } },
    { value = "faceted", label = { fr = "Facettes", en = "Faceted" } },
    { value = "petal", label = { fr = "Pétales", en = "Petals" } },
    { value = "star", label = { fr = "Étoile", en = "Star" } },
    { value = "fluted", label = { fr = "Cannelée", en = "Fluted" } },
    { value = "flower", label = { fr = "Fleur", en = "Flower" } },
    { value = "teeth", label = { fr = "Dents", en = "Teeth" } },
    { value = "drop", label = { fr = "Goutte", en = "Drop" } },
]

[params.sides]
type = "int"
label = { fr = "Côtés / lobes", en = "Sides / lobes" }
default = 8
min = 3
max = 60

[params.depth]
type = "float"
label = { fr = "Profondeur", en = "Depth" }
unit = "%"
help = { fr = "Creux des lobes, en part du rayon.", en = "Depth of the lobes, as a share of the radius." }
default = 15
min = 0
max = 60
step = 1

[params.twist]
type = "float"
label = { fr = "Torsion", en = "Twist" }
unit = "°"
help = { fr = "Rotation de la section du bas jusqu'en haut.", en = "Rotation of the section from bottom to top." }
default = 45
min = -360
max = 360
step = 5

[params.twist_kind]
type = "choice"
label = { fr = "Rythme", en = "Rhythm" }
help = { fr = "Régulière, en S (lente aux extrémités) ou aller-retour (revient en haut).", en = "Even, S-curve (slow at both ends) or back and forth (returns at the top)." }
default = "even"
options = [
    { value = "even", label = { fr = "Régulière", en = "Even" } },
    { value = "s", label = { fr = "En S", en = "S-curve" } },
    { value = "back_and_forth", label = { fr = "Aller-retour", en = "Back & forth" } },
]

[params.taper]
type = "float"
label = { fr = "Resserrement", en = "Taper" }
unit = "%"
help = { fr = "Rétrécit (positif) ou élargit (négatif) la pièce vers le haut, en plus de la silhouette.", en = "Narrows (positive) or widens (negative) the piece towards the top, on top of the silhouette." }
default = 0
min = -60
max = 60
step = 1

[params.cage_softness]
type = "float"
label = { fr = "Douceur cage", en = "Cage softness" }
help = { fr = "0 : la paroi passe par les points de la cage ; 1 : plus douce, en deçà des points.", en = "0: the wall goes through the cage points; 1: softer, inside the points." }
advanced = true
default = 0.6
min = 0
max = 1
step = 0.05

[params.cage_0_1]
type = "float"
label = { fr = "Cage bas 1", en = "Cage bottom 1" }
unit = "mm"
help = { fr = "Pousse (positif) ou rentre (négatif) la paroi autour du point 1 de l'anneau du bas, à 0° (0° : à droite, vu de dessus).", en = "Pushes (positive) or pulls (negative) the wall around point 1 of the bottom ring, at 0° (0°: right, seen from above)." }
advanced = true
default = 0
min = -20
max = 20
step = 0.5

