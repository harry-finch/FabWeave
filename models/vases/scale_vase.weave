format = "fabweave.model"
version = 1

[meta]
name = { fr = "Vase à écailles", en = "Scale vase" }
category = { fr = "Vases et luminaires", en = "Vases & lamps" }
description = { fr = "Vase polygonal aux faces creusées et à la taille resserrée, d'une seule paroi en spirale continue. La buse avance d'un pas régulier le long de la paroi et sort à un point sur deux ; comme chaque tour compte un demi-pas de plus, les sorties se décalent d'un tour à l'autre et la paroi se couvre d'écailles en quinconce.", en = "A polygonal vase with hollowed faces and a narrowed waist, made of a single wall printed as one continuous spiral. The nozzle moves along the wall in even steps and steps out every other point; since each turn has half a step more, the bumps shift from one turn to the next and the wall is covered with staggered scales." }
author = "FabWeave, d'après « ripple texture » d'Andrew Gleadall (FullControl)"
tags = ["vase", "écailles", "texture", "spirale", "polygone", "fullcontrol"]
source = "https://github.com/FullControlXYZ/fullcontrol/blob/master/models/ripple_texture.ipynb"
license = "GPL-3.0"
recommended_nozzle = [0.4, 0.5, 0.6]

[params.sides]
type = "int"
label = { fr = "Côtés", en = "Sides" }
default = 6
min = 3
max = 12

[params.radius]
type = "float"
label = { fr = "Rayon", en = "Radius" }
unit = "mm"
help = { fr = "Distance du centre aux arêtes, en bas et en haut.", en = "Distance from the centre to the edges, at the bottom and top." }
default = 35
min = 10
max = 80
step = 0.5

[params.height]
type = "float"
label = { fr = "Hauteur", en = "Height" }
unit = "mm"
default = 60
min = 10
max = 150
step = 1

[params.hollow]
type = "float"
label = { fr = "Creux des faces", en = "Face hollow" }
unit = "%"
help = { fr = "Profondeur du creux au milieu de chaque face, en part de sa largeur (0 : faces planes).", en = "Depth of the hollow in the middle of each face, as a share of its width (0: flat faces)." }
default = 10
min = 0
max = 30
step = 1

[params.waist]
type = "float"
label = { fr = "Taille", en = "Waist" }
unit = "%"
help = { fr = "Resserrement à mi-hauteur, en part du rayon (négatif : la forme gonfle).", en = "Narrowing half way up, as a share of the radius (negative: the shape swells)." }
default = 12
min = -20
max = 30
step = 1

[params.twist]
type = "float"
label = { fr = "Torsion", en = "Twist" }
unit = "°"
help = { fr = "Rotation de la forme sur toute la hauteur.", en = "Rotation of the shape over the full height." }
default = 0
min = -180
max = 180
step = 5

[params.bottom]
type = "choice"
label = { fr = "Fond", en = "Bottom" }
help = { fr = "Couches pleines en anneaux sous la spirale, au contour de la paroi sans écailles : le fond ne dépasse pas, et les écailles naissent sur les premiers tours au-dessus.", en = "Solid ring layers under the spiral, following the outline of the wall without scales: the bottom does not stick out, and the scales grow over the first turns above it." }
default = "2"
options = [
    { value = "none", label = { fr = "Aucun", en = "None" } },
    { value = "1", label = { fr = "1 couche", en = "1 layer" } },
    { value = "2", label = { fr = "2 couches", en = "2 layers" } },
]

[params.pitch]
type = "float"
label = { fr = "Écaille", en = "Scale length" }
unit = "mm"
help = { fr = "Longueur d'une écaille le long de la paroi (mesurée en bas).", en = "Length of one scale along the wall (measured at the bottom)." }
default = 2
min = 1
max = 6
step = 0.1

[params.depth]
type = "float"
label = { fr = "Relief", en = "Relief" }
unit = "mm"
help = { fr = "Sortie de la buse à chaque écaille.", en = "How far the nozzle steps out for each scale." }
default = 0.8
min = 0
max = 2
step = 0.05

[params.speed]
type = "float"
label = { fr = "Vitesse", en = "Speed" }
unit = "mm/s"
help = { fr = "Vitesse de la paroi ; la moitié sur le premier tour. Les plafonds de l'imprimante et du filament s'appliquent.", en = "Wall speed; half of it on the first turn. Printer and filament limits apply." }
default = 12
min = 3
max = 60
step = 0.5

[params.width_factor]
type = "float"
label = { fr = "Largeur boudin", en = "Bead width" }
unit = "×"
help = { fr = "Largeur de la paroi, en multiple du diamètre de buse. Le boudin large tient les écailles entre elles.", en = "Wall width, as a multiple of the nozzle diameter. The wide bead holds the scales together." }
advanced = true
default = 2.5
min = 1
max = 3
step = 0.1

[params.height_factor]
type = "float"
label = { fr = "Pas vertical", en = "Rise per turn" }
unit = "×"
help = { fr = "Montée par tour, en multiple du diamètre de buse.", en = "Rise per turn, as a multiple of the nozzle diameter." }
advanced = true
default = 0.6
min = 0.2
max = 0.8
step = 0.05
---
// Texture d'après « ripple texture » de FullControl (A. Gleadall, GPL-3.0) :
// un point sur deux sorti de `depth`, un nombre impair de points par tour,
// donc les sorties alternent d'un tour au suivant. Forme FabWeave : polygone
// aux faces creusées, points répartis à pas égal le long du contour, sortie
// selon la normale à la paroi (et non selon le rayon), taille en sablier.

let ew = printer.nozzle_diameter * params.width_factor;
let eh = printer.nozzle_diameter * params.height_factor;
let sides = params.sides;
let r0 = params.radius;

// Contour de base, dense : par face, de l'arête A à l'arête B, creusé vers le
// centre en parabole ; normales extérieures et longueurs cumulées.
let per_face = 64;
let cx = []; let cy = []; let nx = []; let ny = []; let cum = [];
let total_len = 0.0;
for f in 0..sides {
    let a0 = f * TAU / sides - TAU / 4;
    let a1 = (f + 1) * TAU / sides - TAU / 4;
    let ax = r0 * cos(a0); let ay = r0 * sin(a0);
    let bx = r0 * cos(a1); let by = r0 * sin(a1);
    let chord = hypot(bx - ax, by - ay);
    let s = chord * params.hollow / 100.0;                 // creux au milieu de la face
    let mx = (ax + bx) / 2; let my = (ay + by) / 2;
    let ix = -mx / hypot(mx, my); let iy = -my / hypot(mx, my);   // vers le centre
    for j in 0..per_face {
        let u = j / per_face.to_float();
        let px = ax + (bx - ax) * u + ix * s * 4 * u * (1 - u);
        let py = ay + (by - ay) * u + iy * s * 4 * u * (1 - u);
        let dx = (bx - ax) + ix * s * (4 - 8 * u);
        let dy = (by - ay) + iy * s * (4 - 8 * u);
        let d = hypot(dx, dy);
        if cx.len() > 0 {
            total_len += hypot(px - cx[-1], py - cy[-1]);
        }
        cx.push(px); cy.push(py); nx.push(dy / d); ny.push(-dx / d); cum.push(total_len);
    }
}
total_len += hypot(cx[0] - cx[-1], cy[0] - cy[-1]);

// Points d'un tour : nombre impair, à pas égal le long du contour.
let ripples = max(sides, round(total_len / params.pitch)).to_int();
let ppt = 2 * ripples + 1;
let bx = []; let by = []; let bnx = []; let bny = [];
let k = 0;
let m = cx.len();
for i in 0..ppt {
    let target = i * total_len / ppt;
    while k + 1 < m && cum[k + 1] <= target { k += 1; }
    let next = if k + 1 < m { k + 1 } else { 0 };
    let seg = if k + 1 < m { cum[k + 1] - cum[k] } else { total_len - cum[k] };
    let t = if seg > 0 { (target - cum[k]) / seg } else { 0.0 };
    bx.push(cx[k] + (cx[next] - cx[k]) * t);
    by.push(cy[k] + (cy[next] - cy[k]) * t);
    bnx.push(nx[k]); bny.push(ny[k]);
}

let nb = if params.bottom == "2" { 2 } else if params.bottom == "1" { 1 } else { 0 };
let fh = printer.first_layer_height;
let z_bottom = if nb == 0 { 0.0 } else { fh + (nb - 1) * eh };
let turns = floor((params.height - z_bottom) / eh).to_int();
let z0 = if nb == 0 { 0.8 * eh } else { z_bottom };
let waist = params.waist / 100.0;
let twist = rad(params.twist);
let depth = params.depth;
let height = params.height;

// Position du point `t` de la spirale (compté depuis le départ), à la hauteur
// z, part `g` des écailles.
let at = |t, z, g| {
    let i = t % ppt;
    let sc = 1.0 - waist * sin(PI * clamp(z / height, 0.0, 1.0));
    let rot = twist * z / height;
    let c = cos(rot);
    let s = sin(rot);
    let out = if t % 2 == 0 { depth * g } else { 0.0 };
    let x = bx[i] * sc + bnx[i] * out;
    let y = by[i] * sc + bny[i] * out;
    [x * c - y * s, x * s + y * c]
};

let path = new_path();

// Fond : anneaux au contour sans écailles (pour ne pas dépasser de la paroi) ;
// la dernière couche du centre vers le bord, pour que la spirale parte du
// contour. Les écailles naissent ensuite sur `ramp` mm.
let fw = printer.nozzle_diameter * 1.125;
path.set_speed_factor(1);
for j in 0..nb {
    let z = fh + j * eh;
    let h = if j == 0 { fh } else { eh };
    let contour = points();
    for i in 0..=ppt {
        let p = at.call(i, 0.0, 0.0);
        contour.push(p[0], p[1], z);
    }
    let rings = contour.fill_rings(fw, ew / 2 + fw * 0.35);
    let last = j == nb - 1;
    if last {
        rings.reverse();
    } else {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
    }
    for c in rings {
        path.travel_to(c);
        path.print_points(c, fw, h);
    }
    if last {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
    }
}

path.set_speed(params.speed / 2);
let full = false;
let ramp = 6 * eh;
let start = if nb == 0 { 0 } else { 1 };
let total = turns * ppt;
for t in start..=total {
    let tv = t / ppt.to_float();
    let z = tv * eh;
    let h = if tv >= 1.0 { eh } else if nb == 0 { eh * (1.0 + tv * 0.4) } else { eh * max(tv, 0.1) };
    if tv >= 1.0 && !full {
        path.set_speed(params.speed);
        full = true;
    }
    // Comme `at`, écrit en ligne : un appel de fermeture par point coûte
    // cher dans le navigateur.
    let i = t % ppt;
    let sc = 1.0 - waist * sin(PI * min(z / height, 1.0));
    let g = if nb == 0 { 1.0 } else { clamp(z / ramp, 0.0, 1.0) };
    let out = if t % 2 == 0 { depth * g * g * (3.0 - 2.0 * g) } else { 0.0 };
    let x = bx[i] * sc + bnx[i] * out;
    let y = by[i] * sc + bny[i] * out;
    if twist == 0.0 {
        path.print_to(x, y, z0 + z, ew, h);
    } else {
        let rot = twist * z / height;
        let c = cos(rot);
        let s = sin(rot);
        path.print_to(x * c - y * s, x * s + y * c, z0 + z, ew, h);
    }
    if t == start {
        path.note(#{ fr: "Départ de la spirale", en: "Spiral start" });
    }
}

path
