format = "fabweave.model"
version = 1

[meta]
name = { fr = "Vase à ondulations", en = "Ripple vase" }
category = { fr = "Vases et luminaires", en = "Vases & lamps" }
description = { fr = "Paroi d'un seul boudin large, imprimée en spirale continue. La buse ondule vers l'intérieur et l'extérieur à chaque tour, avec un demi-pas de décalage d'un tour à l'autre : la paroi se tisse d'elle-même. Branches en étoile, torsion et renflement en option ; fond plein d'une ou deux couches (lignes ou anneaux), qui épouse les ondulations.", en = "A single wide bead wall printed as one continuous spiral. The nozzle ripples in and out on every turn, shifted by half a ripple from one turn to the next, so the wall weaves itself. Optional star tips, twist and bulge; optional one or two layer solid bottom (lines or rings) that follows the ripples." }
author = "Andrew Gleadall (FullControl) ; port FabWeave"
tags = ["vase", "spirale", "texture", "fullcontrol"]
source = "https://github.com/FullControlXYZ/fullcontrol/blob/master/models/ripple_texture.ipynb"
license = "GPL-3.0"
recommended_nozzle = [0.4, 0.5, 0.6]

[params.inner_radius]
type = "float"
label = { fr = "Rayon de base", en = "Base radius" }
unit = "mm"
help = { fr = "Rayon du cercle de base ; les branches, les ondulations et le renflement s'ajoutent vers l'extérieur.", en = "Radius of the base circle; tips, ripples and bulge add outwards." }
default = 15
min = 5
max = 40
step = 0.5

[params.height]
type = "float"
label = { fr = "Hauteur", en = "Height" }
unit = "mm"
default = 40
min = 5
max = 150
step = 1

[params.bottom]
type = "choice"
label = { fr = "Fond", en = "Bottom" }
help = { fr = "Couches pleines sous la spirale, au contour exact de la base (ondulations comprises). La spirale démarre sur la dernière, sans couture. Sans fond, le vase est un manchon ouvert, comme l'original.", en = "Solid layers under the spiral, following the exact outline of the base (ripples included). The spiral starts on the last one, without a seam. Without a bottom the vase is an open sleeve, like the original." }
default = "none"
options = [
    { value = "none", label = { fr = "Aucun", en = "None" } },
    { value = "1", label = { fr = "1 couche", en = "1 layer" } },
    { value = "2", label = { fr = "2 couches", en = "2 layers" } },
]

[params.bottom_pattern]
type = "choice"
label = { fr = "Motif du fond", en = "Bottom pattern" }
help = { fr = "Lignes croisées d'une couche à l'autre, ou anneaux qui suivent le contour vers le centre (sans effet sans fond).", en = "Lines crossed from one layer to the next, or rings that follow the outline towards the centre (no effect without a bottom)." }
default = "lines"
options = [
    { value = "lines", label = { fr = "Lignes", en = "Lines" } },
    { value = "rings", label = { fr = "Anneaux", en = "Rings" } },
]

[params.twist]
type = "float"
label = { fr = "Torsion", en = "Twist" }
unit = "%"
help = { fr = "Rotation de la forme sur toute la hauteur : 100 % = un tour complet dans le sens inverse des aiguilles d'une montre.", en = "Rotation of the shape over the full height: 100% = one full anticlockwise turn." }
default = 10
min = -100
max = 100
step = 1

[params.star_tips]
type = "int"
label = { fr = "Branches", en = "Star tips" }
help = { fr = "Nombre de pointes qui sortent du cercle (0 : vase rond).", en = "Number of points sticking out of the circle (0: round vase)." }
default = 4
min = 0
max = 10

[params.tip_length]
type = "float"
label = { fr = "Saillie", en = "Tip length" }
unit = "mm"
help = { fr = "Longueur des branches au-delà du rayon intérieur ; négative, elles rentrent vers le centre.", en = "How far tips stick out beyond the inner radius; negative values point inwards." }
default = 5
min = -20
max = 20
step = 0.5

[params.tip_pointiness]
type = "float"
label = { fr = "Finesse", en = "Pointiness" }
help = { fr = "Forme des branches : au-dessus de 1, elles s'affinent en pointes ; en dessous, elles s'arrondissent.", en = "Tip shape: above 1 tips get pointier; below 1 they get rounder." }
default = 1.5
min = 0.25
max = 5
step = 0.05

[params.bulge]
type = "float"
label = { fr = "Renflement", en = "Bulge" }
unit = "mm"
help = { fr = "La forme gonfle de cette valeur à mi-hauteur (négatif : elle se resserre).", en = "The shape swells by this amount half way up (negative: it narrows)." }
default = 2
min = -20
max = 20
step = 0.5

[params.ripples_per_layer]
type = "int"
label = { fr = "Ondulations", en = "Ripples" }
help = { fr = "Allers-retours de la buse par tour. Un demi-pas s'ajoute à chaque tour pour décaler les ondulations d'une couche à l'autre.", en = "In-out waves of the nozzle per turn. Half a ripple is added per turn so the ripples alternate between layers." }
default = 50
min = 10
max = 100

[params.ripple_depth]
type = "float"
label = { fr = "Profondeur", en = "Ripple depth" }
unit = "mm"
help = { fr = "Amplitude radiale de chaque ondulation (aller-retour de la buse).", en = "Radial amplitude of each ripple." }
default = 1
min = 0
max = 5
step = 0.1

[params.speed]
type = "float"
label = { fr = "Vitesse", en = "Speed" }
unit = "mm/s"
help = { fr = "Vitesse d'impression ; la moitié sur le premier tour. Les plafonds de l'imprimante et du filament s'appliquent.", en = "Print speed; half of it on the first turn. Printer and filament limits apply." }
default = 8
min = 2
max = 60
step = 0.5

[params.ripple_segments]
type = "int"
label = { fr = "Points/onde", en = "Points/ripple" }
help = { fr = "2 : zigzag. Davantage : onde lisse, mais beaucoup plus de points.", en = "2: zigzag. More: smooth wave, but many more points." }
advanced = true
default = 2
min = 2
max = 12

[params.width_factor]
type = "float"
label = { fr = "Largeur boudin", en = "Bead width" }
unit = "×"
help = { fr = "Largeur d'extrusion, en multiple du diamètre de buse. Le boudin large donne la tenue de la paroi.", en = "Extrusion width, as a multiple of the nozzle diameter. The wide bead holds the wall together." }
advanced = true
default = 2.5
min = 1
max = 3
step = 0.1

[params.height_factor]
type = "float"
label = { fr = "Pas vertical", en = "Rise per turn" }
unit = "×"
help = { fr = "Montée par tour, en multiple du diamètre de buse.", en = "Rise per turn, as a multiple of the nozzle diameter." }
advanced = true
default = 0.6
min = 0.2
max = 0.8
step = 0.05

[params.first_layer_boost]
type = "float"
label = { fr = "Surplus départ", en = "Start extra" }
unit = "%"
help = { fr = "Surcroît de matière ajouté progressivement sur le premier tour : la buse s'éloigne du plateau en spirale, il faut combler l'écart.", en = "Extra material added progressively over the first turn: the nozzle spirals away from the bed and the gap must be filled." }
advanced = true
default = 40
min = 0
max = 100
step = 5
---
// Port de « ripple texture demo » de FullControl (A. Gleadall, GPL-3.0).
// Une seule spirale : Z monte continûment de `eh` par tour. Fond (ajout
// FabWeave) : couches pleines au contour du tour de spirale qui les suit.

let ew = printer.nozzle_diameter * params.width_factor;   // largeur du boudin
let eh = printer.nozzle_diameter * params.height_factor;  // montée par tour
let segs = params.ripple_segments;
let ripples = params.ripples_per_layer + 0.5;             // demi-pas de décalage
let layer_segs = ripples * segs;                          // points par tour
let twist = params.twist / 100.0;
let boost = params.first_layer_boost / 100.0;

// Fond : couche 1 à la hauteur de première couche du profil, couche 2 à + eh.
let nb = if params.bottom == "2" { 2 } else if params.bottom == "1" { 1 } else { 0 };
let fh = printer.first_layer_height;
let z_bottom = if nb == 0 { 0.0 } else { fh + (nb - 1) * eh };
let layers = floor((params.height - z_bottom) / eh).to_int();
let total = floor(layers * layer_segs).to_int();
let z0 = if nb == 0 { 0.8 * eh } else { z_bottom };       // premier tour écrasé, ou posé sur le fond

// Forme : angle et rayon au tour `tv` (flottant ; négatif pour le fond), hauteur `z` dans la spirale.
let angle_at = |tv| tv * TAU * (1.0 + twist / layers) - TAU / 4;  // départ devant, au milieu
let radius_at = |tv, z| params.inner_radius
    + params.ripple_depth * (0.5 + 0.5 * cos(ripples * tv * TAU))
    + params.tip_length * pow(0.5 - 0.5 * cos(params.star_tips * tv * TAU), params.tip_pointiness)
    + params.bulge * sin(z / params.height * 0.5 * TAU);

let path = new_path();

// Le fond : couche j au contour du tour (j − nb) ; la dernière se termine au
// départ de la spirale. Lignes de 1,125 × buse, croisées d'une couche à l'autre,
// ou anneaux concentriques, qui mordent de 15 % sur le boudin du contour.
// Anneaux de la dernière couche du centre vers le bord : le contour, puis la
// spirale, suivent sans long trajet. Vitesse nominale du filament (plafonnée
// en première couche), et non celle, lente, de la paroi.
let fw = printer.nozzle_diameter * 1.125;
path.set_speed_factor(1);
for j in 0..nb {
    let z = fh + j * eh;
    let h = if j == 0 { fh } else { eh };
    let contour = points();
    let n = ceiling(layer_segs).to_int();
    for i in 0..=n {
        let tv = j - nb + i / n.to_float();
        let r = radius_at.call(tv, 0.0);
        let a = angle_at.call(tv);
        contour.push(r * cos(a), r * sin(a), z);
    }
    let last = j == nb - 1;
    let inset = ew / 2 + fw * 0.35;
    let chains = if params.bottom_pattern == "rings" {
        let rings = contour.fill_rings(fw, inset);
        if last { rings.reverse(); }
        rings
    } else {
        contour.fill_lines(fw, if j % 2 == 0 { PI / 4 } else { -PI / 4 }, inset)
    };
    if !last {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
        if j == 0 {
            path.note(#{ fr: "Fond : contour, puis remplissage", en: "Bottom: outline, then infill" });
        }
    }
    for c in chains {
        path.travel_to(c);
        path.print_points(c, fw, h);
    }
    if last {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
    }
}

path.set_speed(params.speed / 2);
let full_speed = false;
let t_start = if nb == 0 { 0 } else { 1 };                // sur le fond, le point 0 clôt le contour
for t in t_start..total {
    let tv = t / layer_segs;                              // 0 → layers
    let z = tv * eh;
    let r = radius_at.call(tv, z);
    // Premier tour : la hauteur du boudin s'ajuste à l'écart réel sous la buse
    // (sur le plateau : grandit pour combler l'écart ; sur le fond : part de presque rien).
    let h = if tv >= 1.0 { eh } else if nb == 0 { eh * (1.0 + tv * boost) } else { eh * max(tv, 0.1) };
    if tv >= 1.0 && !full_speed {
        path.set_speed(params.speed);
        full_speed = true;
    }
    path.print_polar(r, angle_at.call(tv), z0 + z, ew, h);
    if t == t_start {
        path.note(#{ fr: "Départ de la spirale, devant au milieu", en: "Spiral start, front middle" });
    }
}
path.note(#{ fr: "Fin de la spirale", en: "End of the spiral" });

path
