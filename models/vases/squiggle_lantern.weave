format = "fabweave.model"
version = 1

[meta]
name = { fr = "Photophore à vermicelles", en = "Squiggle lantern" }
category = { fr = "Vases et luminaires", en = "Vases & lamps" }
description = { fr = "Paroi fine en spirale continue d'où la buse sort au hasard pour dessiner de petites boucles, puis revient : chaque vermicelle est un vrai boudin. Les boucles qui débordent dans le vide retombent sur celles d'en dessous ; c'est cet affaissement qui fait la texture. La paroi entre les boucles laisse passer la lumière. Prévu pour une bougie LED (une flamme ramollit le PLA à quelques centimètres).", en = "A thin wall printed as one continuous spiral, from which the nozzle randomly steps out to draw small loops, then comes back: each squiggle is a real bead. Loops reaching out over air droop onto the ones below; that sagging makes the texture. The wall between the loops lets the light through. Meant for an LED tealight (a flame softens PLA a few centimetres away)." }
author = "FabWeave"
tags = ["photophore", "bougie LED", "texture", "boucles", "aléatoire", "spirale"]
recommended_nozzle = [0.4, 0.5, 0.6]

[params.radius]
type = "float"
label = { fr = "Rayon", en = "Radius" }
unit = "mm"
help = { fr = "Rayon de la paroi, sous les boucles. 35 mm laisse passer une bougie chauffe-plat (Ø 38 mm) avec du jeu.", en = "Wall radius, under the loops. 35 mm leaves room for a tealight (Ø 38 mm)." }
default = 35
min = 15
max = 80
step = 0.5

[params.height]
type = "float"
label = { fr = "Hauteur", en = "Height" }
unit = "mm"
default = 60
min = 10
max = 150
step = 1

[params.bottom]
type = "choice"
label = { fr = "Fond", en = "Bottom" }
help = { fr = "Couches pleines en anneaux sous la spirale, au rayon de la paroi : le fond ne dépasse pas, et les boucles naissent sur les premiers tours au-dessus. Sans fond, c'est un manchon à poser sur la bougie.", en = "Solid ring layers under the spiral, at the wall radius: the bottom does not stick out, and the loops grow over the first turns above it. Without a bottom it is a sleeve to put over the candle." }
default = "2"
options = [
    { value = "none", label = { fr = "Aucun", en = "None" } },
    { value = "1", label = { fr = "1 couche", en = "1 layer" } },
    { value = "2", label = { fr = "2 couches", en = "2 layers" } },
]

[params.density]
type = "float"
label = { fr = "Densité", en = "Density" }
unit = "%"
help = { fr = "Part de la paroi couverte de boucles, tour après tour.", en = "Share of the wall covered by loops, turn after turn." }
default = 45
min = 5
max = 90
step = 5

[params.loop_length]
type = "float"
label = { fr = "Longueur", en = "Length" }
unit = "mm"
help = { fr = "Longueur moyenne d'une boucle le long de la paroi (tirée entre 60 et 140 % de cette valeur).", en = "Average length of a loop along the wall (drawn between 60 and 140% of this value)." }
default = 3.5
min = 1.5
max = 10
step = 0.1

[params.loop_depth]
type = "float"
label = { fr = "Saillie", en = "Reach" }
unit = "mm"
help = { fr = "Sortie maximale d'une boucle hors de la paroi (tirée entre 50 et 100 % de cette valeur). Au-delà de la largeur du boudin, la boucle est dans le vide et retombe.", en = "Maximum reach of a loop out of the wall (drawn between 50 and 100% of this value). Beyond the bead width the loop is over air and droops." }
default = 1.8
min = 0.3
max = 4
step = 0.1

[params.seed]
type = "int"
label = { fr = "Tirage", en = "Draw" }
help = { fr = "Numéro du tirage : chaque valeur place les boucles autrement, toujours de la même façon pour un même numéro.", en = "Draw number: each value places the loops differently, always the same way for the same number." }
default = 1
min = 1
max = 999

[params.speed]
type = "float"
label = { fr = "Vitesse", en = "Speed" }
unit = "mm/s"
help = { fr = "Vitesse de la paroi ; la moitié sur le premier tour. Les plafonds de l'imprimante et du filament s'appliquent.", en = "Wall speed; half of it on the first turn. Printer and filament limits apply." }
default = 15
min = 3
max = 60
step = 0.5

[params.loop_speed]
type = "float"
label = { fr = "Vitesse boucles", en = "Loop speed" }
unit = "%"
help = { fr = "Vitesse dans les boucles, en part de celle de la paroi : plus lent, le boudin refroidit avant de trop retomber.", en = "Speed in the loops, as a share of the wall speed: slower lets the bead cool before it droops too much." }
advanced = true
default = 60
min = 20
max = 100
step = 5

[params.segment]
type = "float"
label = { fr = "Pas", en = "Step" }
unit = "mm"
help = { fr = "Longueur des segments de la paroi entre les boucles.", en = "Segment length of the wall between loops." }
advanced = true
default = 0.8
min = 0.3
max = 2
step = 0.05

[params.width_factor]
type = "float"
label = { fr = "Largeur boudin", en = "Bead width" }
unit = "×"
help = { fr = "Largeur du boudin, en multiple du diamètre de buse : fin, la paroi est plus translucide.", en = "Bead width, as a multiple of the nozzle diameter: thinner makes the wall more translucent." }
advanced = true
default = 1.5
min = 1
max = 3
step = 0.1

[params.height_factor]
type = "float"
label = { fr = "Pas vertical", en = "Rise per turn" }
unit = "×"
help = { fr = "Montée par tour, en multiple du diamètre de buse.", en = "Rise per turn, as a multiple of the nozzle diameter." }
advanced = true
default = 0.6
min = 0.2
max = 0.8
step = 0.05
---
// Paroi en spirale continue (mode vase), parcourue à l'abscisse `s` (mm le
// long de la paroi, tous tours confondus). Entre deux boucles, la buse suit le
// cercle ; une boucle sort en arc (sinus) jusqu'à sa saillie et revient, dans
// la même extrusion. Longueur, saillie et écart de chaque boucle sont tirés
// au hasard (générateur de Park et Miller : reproductible, entiers sans
// dépassement).

let ew = printer.nozzle_diameter * params.width_factor;
let eh = printer.nozzle_diameter * params.height_factor;
let r0 = params.radius;
let circ = TAU * r0;
let seg = params.segment;
let mean_len = params.loop_length;
let density = params.density / 100.0;
let mean_gap = mean_len * (1.0 - density) / density;
let speed = params.speed;
let loop_speed = speed * params.loop_speed / 100.0;

let rng = (params.seed * 7919 + 17) % 2147483647;

let nb = if params.bottom == "2" { 2 } else if params.bottom == "1" { 1 } else { 0 };
let fh = printer.first_layer_height;
let z_bottom = if nb == 0 { 0.0 } else { fh + (nb - 1) * eh };
let turns = floor((params.height - z_bottom) / eh).to_int();
let z0 = if nb == 0 { 0.8 * eh } else { z_bottom };
let total = turns * circ;
let ramp = 6 * eh;

let path = new_path();

// Fond : anneaux dans le cercle de la paroi, la dernière couche du centre vers
// le bord pour que la spirale parte du contour.
let fw = printer.nozzle_diameter * 1.125;
let n = ceiling(circ / seg).to_int();
path.set_speed_factor(1);
for j in 0..nb {
    let z = fh + j * eh;
    let h = if j == 0 { fh } else { eh };
    let contour = circle(0, 0, z, r0, -TAU / 4, n);
    let rings = contour.fill_rings(fw, ew / 2 + fw * 0.35);
    let last = j == nb - 1;
    if last {
        rings.reverse();
    } else {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
    }
    for c in rings {
        path.travel_to(c);
        path.print_points(c, fw, h);
    }
    if last {
        path.travel_to(contour);
        path.print_points(contour, ew, h);
    }
}

// Spirale. Premier écart tiré, puis : paroi jusqu'à la boucle suivante,
// boucle, nouvel écart.
path.set_speed(speed / 2);
let full = false;
rng = (rng * 48271) % 2147483647;
let next = mean_gap * (0.5 + rng / 2147483647.0);
let s = 0.0;
let first = true;
while s < total {
    let in_loop = s >= next && s < total;
    let len = 0.0;
    let reach = 0.0;
    if in_loop {
        rng = (rng * 48271) % 2147483647;
        len = mean_len * (0.6 + 0.8 * rng / 2147483647.0);
        rng = (rng * 48271) % 2147483647;
        reach = params.loop_depth * (0.5 + 0.5 * rng / 2147483647.0);
    }
    // Points à poser : un seul sur la paroi, ou toute la boucle.
    let steps = if in_loop { max(6, ceiling(len / 0.4)).to_int() } else { 1 };
    for k in 1..=steps {
        let u = k / steps.to_float();
        // Pas de paroi ; le dernier avant une boucle s'allonge jusqu'à elle
        // plutôt que de laisser un bout de segment minuscule.
        let wall = if next - s < 1.5 * seg { next } else { s + seg };
        let sk = if in_loop { s + len * u } else if first { 0.0 } else { min(wall, total) };
        let tv = sk / circ;                                   // tours depuis le départ
        let z = tv * eh;
        let g = if nb == 0 { 1.0 } else { clamp(z / ramp, 0.0, 1.0) };
        let out = if in_loop { reach * g * g * (3.0 - 2.0 * g) * sin(PI * u) } else { 0.0 };
        let h = if tv >= 1.0 { eh } else if nb == 0 { eh * (1.0 + tv * 0.4) } else { eh * max(tv, 0.1) };
        if tv >= 1.0 && !full {
            path.set_speed(speed);
            full = true;
        }
        if in_loop && k == 1 && full { path.set_speed(loop_speed); }
        let a = sk / r0 - TAU / 4;
        let r = r0 + out;
        // Sur le fond, le point de départ clôt déjà le contour.
        if !(first && nb > 0) {
            path.print_to(r * cos(a), r * sin(a), z0 + z, ew, h);
        }
        if first {
            path.note(#{ fr: "Départ de la spirale", en: "Spiral start" });
        }
        first = false;
        if !in_loop { s = sk; }
    }
    if in_loop {
        if full { path.set_speed(speed); }
        s += len;
        rng = (rng * 48271) % 2147483647;
        next = s + mean_gap * (0.5 + rng / 2147483647.0);
    }
}

path
